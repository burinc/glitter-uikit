;; screen-grab manifest for glitter-uikit's interactive demos.
;; https://github.com/burinc/b12n-screen-grab
;;
;; Driver is :spawn — each demo is launched fresh via `jolt -M:<id>`, captured,
;; and torn down. Both demos are interactive and deliberately carry no
;; :auto-quit-ms, so :spawn's own teardown is what ends them.
;;
;; STILLS, not GIFs, deliberately. glitter's sibling manifest steers its demos
;; with Tab/Space, but that recipe is verified against GTK and does NOT
;; obviously carry to AppKit: on macOS, Tab moves focus between text fields and
;; lists, and reaching a BUTTON requires "Full Keyboard Access" to be enabled in
;; System Settings. Rather than assume glitter's timeline transfers — the same
;; assumption that produced a real threading defect elsewhere in this port —
;; stills are captured first, which need no synthetic input at all. Upgrading to
;; GIFs is a deliberate follow-up that starts by probing what steering actually
;; reaches an AppKit window.
{:driver  :spawn
 ;; `shot` accepts #{:simctl :cgevent-png :screencapture}; :cgevent-gif is
 ;; record-only. cgevent-png keeps capture on the same toolchain as the rest.
 :capture :cgevent-png

 ;; Two items, and no existing registry worth wiring — inline rather than
 ;; :examples-cmd, per screen-grab's own guidance for a handful of items.
 :examples
 [;; HAND-STEERED, not reproducible by this manifest. Synthetic input does not
  ;; reach an AppKit window here — probed 2026-08-25: five Tab/Space presses left
  ;; Count at 0 with no focus ring, and :type left a focused NSTextField showing
  ;; only its placeholder. screen-grab's own README rules out :click/:move/:drag
  ;; for any app. glitter's GTK demos DO steer via Tab/Space, so this is a real
  ;; toolkit difference, not a broken setup: on macOS, keyboard focus reaches a
  ;; button only with "Full Keyboard Access" enabled.
  ;; The committed counter.png therefore shows Count: 5 from a human's clicks.
  {:id    "counter"
   :group "basics"
   :run   "jolt -M:counter"
   :src   "examples/glitter_uikit/counter.clj"
   :desc  "The canonical demo. One state atom, a pure state -> hiccup view, handlers as data."}
  ;; Fully reproducible, unlike counter: this demo's INITIAL render is already
  ;; the interesting one (six seeded list items), so no steering is needed.
  {:id    "widgets"
   :group "basics"
   :run   "jolt -M:widgets"
   :src   "examples/glitter_uikit/widgets.clj"
   :description "Every widget tag the renderer registers, in one window — including :separator and :scrolled, which no other example uses."}

  ;; Also fully reproducible: the initial 0 C / 32 F render already shows both
  ;; linked fields, so no steering is needed to get a meaningful frame.
  {:id    "temperature"
   :group "7guis"
   :run   "jolt -M:temperature"
   :src   "examples/glitter_uikit/temperature.clj"
   :description "The 7GUIs Temperature Converter — two linked numeric fields, ported from glitter with its domain logic unchanged."}

  {:id    "todo"
   :group "basics"
   :run   "jolt -M:todo"
   :src   "examples/glitter_uikit/todo.clj"
   :desc  "A task board on glitter.nexus: derived counts computed inline, an entry, and checkbutton toggles."}]

 :out-dir "docs/demos"
 :ledger  "docs/demos/ledger.edn"
 :readme  "docs/demos/README.md"
 :title   "Demos"
 :preamble "Screenshots of glitter-uikit's interactive demos, rendered through AppKit. The images here are committed, so you do not need the capture tool to browse them.\n\n`todo.png` is a plain `screen-grab shot` of the demo's initial state and regenerates faithfully. **`counter.png` was steered by hand** \u2014 a person clicked `+ 1` five times and focused the window before the frame was taken \u2014 because synthetic input does not reach an AppKit window here. A normal re-run leaves it alone: the ledger hashes each item's `:src`, so an unchanged `counter.clj` reports `up to date` (verified). But `--force`, or any edit to `counter.clj`, WILL recapture it and silently replace the steered frame with an initial-state one reading `Count: 0`. If that happens, re-steer it by hand rather than committing the regression."

 :groups [{:key "basics" :title "basics"}]

 ;; Windows are sized by the demos themselves (counter 320x160, todo 480x420),
 ;; so :width here is the captured image width, not the window's.
 :defaults {:width 520 :warmup 12}

 :overrides
 {"todo" {:width 620}}}
